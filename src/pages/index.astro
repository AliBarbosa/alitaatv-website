---
import '../styles/global.css';
import { site } from '../data/site';
const schema = {'@context':'https://schema.org','@type':'Person',name:site.name,url:`https://${site.domain}`,description:site.bio,sameAs:site.socials.map(s => s.url)};
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="description" content="AlitaaTV: gaming, humor y una comunidad que decide cada partida. Directos de lunes a viernes a las 22:00 h (España)." /><meta name="theme-color" content="#10051f" /><link rel="canonical" href={`https://${site.domain}/`} /><link rel="icon" type="image/png" href="/images/logo-round.png" /><meta property="og:type" content="website" /><meta property="og:title" content="AlitaaTV · Gaming, risas y comunidad" /><meta property="og:description" content="Directos de lunes a viernes a las 22:00 h (España)." /><meta property="og:image" content={`https://${site.domain}/images/banner.jpg`} /><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><title>AlitaaTV · Gaming, risas y comunidad</title></head>
<body><a class="skip" href="#contenido">Saltar al contenido</a><header><nav class="shell nav" aria-label="Navegación principal"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="46" height="46" /><span>AlitaaTV</span></a><button class="menu" aria-label="Abrir menú" aria-expanded="false">☰</button><div class="links"><a href="#sobre-mi">Sobre mí</a><a href="#horario">Horario</a><a href="#clips">Clips</a><a href="#comunidad">Comunidad</a><a class="live" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ↗</a></div></nav></header>
<main id="contenido"><section class="hero" id="inicio"><div class="grid"></div><div class="shell hero-in"><div class="copy"><p class="eyebrow">● LA PARTIDA EMPIEZA AQUÍ</p><h1>Gaming, risas<br /><i>y buena vibra.</i></h1><p>Un rincón para jugar, reír y decidir el próximo caos juntos. GTA, terror, indies y coop con una comunidad que siempre tiene algo que decir.</p><div class="actions"><a class="button primary" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ▶</a><a class="button ghost" href="#horario">Próximo directo ↓</a></div><small>◈ <span data-local-schedule>Lun — Vie · 22:00 (hora de España)</span></small></div><div class="visual"><div class="ring"></div><img class="profile" src="/images/profile.png" alt="Ilustración de AlitaaTV sonriendo en su setup gamer" width="1024" height="1024" fetchpriority="high" /><span class="badge livebadge">● EN VIVO<br /><small>en Twitch</small></span><span class="badge gamer">🎮 Variety<br />Streamer</span></div></div></section>
<div class="ticker">GTA　✦　 TERROR　✦　 INDIES　✦　 COOPERATIVOS　✦　 GTA　✦　 TERROR　✦　 INDIES　✦　 COOPERATIVOS</div>
<section class="section shell" id="sobre-mi"><p class="label">01　SOBRE MÍ</p><div class="two"><h2>Más que partidas.<br /><i>Una comunidad.</i></h2><div><p class="lead">{site.bio}</p><p>En cada stream, el chat forma parte de la aventura: retos, recompensas, decisiones imposibles y los mejores momentos inesperados.</p><a class="textlink" href="#comunidad">Conoce la comunidad →</a></div></div></section>
<section class="schedule" id="horario"><div class="shell"><p class="label">02　HORARIO</p><div class="schedule-card"><div><p class="eyebrow">CUANDO NOS VEMOS</p><h2>La noche es<br /><i>nuestra.</i></h2><p>Enciende las luces de neón y súmate al chat. Cada noche puede pasar cualquier cosa.</p></div><div class="time"><span>LUN — VIE</span><strong data-local-time>22:00</strong><small data-local-timezone>Tu hora local</small><a class="button primary" href={site.twitch} target="_blank" rel="noreferrer">Abrir Twitch ↗</a></div></div></div></section>
<section class="section shell" id="clips"><div class="heading"><div><p class="label">03　CLIPS Y VÍDEOS</p><h2>Momentos que<br /><i>no se planean.</i></h2></div><a class="textlink" href="https://www.youtube.com/@alitaatv" target="_blank" rel="noreferrer">Ver YouTube ↗</a></div><div class="clips"><a class="clip big" href="https://www.youtube.com/@alitaatv" target="_blank" rel="noreferrer"><img src="/images/banner.jpg" alt="Setup gamer de AlitaaTV iluminado con neón" width="1680" height="280" loading="lazy" /><b>▶</b><span><small>EN YOUTUBE</small><strong>Los mejores momentos de la comunidad</strong></span></a><a class="clip pink" href="https://www.tiktok.com/@alitaatv" target="_blank" rel="noreferrer"><b>▶</b><span><small>EN TIKTOK</small><strong>Caos, risas y clips</strong></span></a><a class="clip blue" href={site.twitch} target="_blank" rel="noreferrer"><b>▶</b><span><small>EN TWITCH</small><strong>Directos sin guion</strong></span></a></div></section>
<section class="community" id="comunidad"><div class="shell two community-in"><div><p class="label">04　COMUNIDAD</p><h2>El chat manda.<br /><i>Siempre.</i></h2><p>Únete a Discord para enterarte de los directos, compartir memes y no perderte ningún reto.</p><a class="button primary" href="https://discord.gg/9BDYrWpPsM" target="_blank" rel="noreferrer">Unirme a Discord ↗</a></div><div class="logo-orbit"><span>ALITAATV · COMUNIDAD · ALITAATV · COMUNIDAD ·</span><img src="/images/logo-round.png" alt="Logotipo de AlitaaTV" width="1024" height="1024" loading="lazy" /></div></div></section>
<section class="section shell social-section"><div><p class="label">05　SIGUE EL VIAJE</p><h2>Nos vemos<br /><i>en todas partes.</i></h2></div><div class="socials">{site.socials.map((social, index) => <a href={social.url} target="_blank" rel="noreferrer"><small>0{index + 1}</small><span>{social.name}</span><b>↗</b></a>)}</div></section>
<section class="shell merch"><div><small>PRÓXIMAMENTE</small><h2>Merch de otro<br /><i>universo.</i></h2></div><p>Estamos preparando algo especial para que lleves la vibra de AlitaaTV contigo.</p><img src="/images/logo-mark.png" alt="" width="180" height="180" loading="lazy" /></section></main>
<footer><div class="shell foot"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="40" height="40" /><span>AlitaaTV</span></a><div><a href={`mailto:${site.email}`}>{site.email}</a><p>© {new Date().getFullYear()} AlitaaTV. Hecho con buena vibra.</p></div></div></footer><script>const b=document.querySelector('.menu'),l=document.querySelector('.links');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));l?.classList.toggle('open',!o)});const p=d=>Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));const now=new Date(),m=p(now),g=new Date(Date.UTC(+m.year,+m.month-1,+m.day,22)),q=p(g),stream=new Date(g.getTime()-(Date.UTC(+q.year,+q.month-1,+q.day,+q.hour,+q.minute)-g.getTime())),local=new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(stream);document.querySelectorAll('[data-local-time]').forEach(e=>e.textContent=local);document.querySelectorAll('[data-local-schedule]').forEach(e=>e.textContent=`Lun — Vie · ${local} (tu hora local)`);</script></body></html>

---
import '../styles/global.css';
import { site } from '../data/site';
const schema = {'@context':'https://schema.org','@type':'Person',name:site.name,url:`https://${site.domain}`,sameAs:site.links.map(link => link.url)};
const crown = '<svg class="crown" viewBox="0 0 48 34" aria-hidden="true"><path d="M5 25 3 8l11 9L24 3l9 14 12-9-3 17M6 31c11-2.5 24-2.5 37-1"/><circle cx="3" cy="5" r="2.2"/><circle cx="45" cy="5" r="2.2"/></svg>';
const socials = site.links.filter(link => link.icon !== 'twitch');
const icons = {
  twitch: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3 2.5 7v13H7v2.5h2.5L12 20h4l5.5-5.5V3zm15.5 10.5L16 17h-4.5L9 19.5V17H5V5h14.5z" class="fill"/><path d="M11 8h2v5h-2zm5 0h2v5h-2z" class="fill"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" class="fill"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.1a3.8 3.8 0 1 1-3.2-3.75V7.2A7 7 0 1 0 17 14V8.5c1 .8 2.3 1.3 4 1.3V6.6c-2.1 0-3.7-1.4-4-3.6z" class="fill"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2C2.5 10 2.5 12 2.5 12s0 2 .5 3.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2c.5-1.8.5-3.8.5-3.8s0-2-.5-3.8z" class="fill"/><path d="m10 15 5-3-5-3z" class="cut"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.8 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.5 1.6-1.5H17V3.7c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.2H8v3.1h2.6v8z" class="fill"/></svg>',
  discord: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 5.2A16 16 0 0 0 15.7 4l-.5 1a14 14 0 0 0-6.4 0l-.5-1a16 16 0 0 0-3.8 1.2C2.1 8.8 1.5 12.3 1.8 15.7A15.3 15.3 0 0 0 6.5 18l1.1-1.5a9 9 0 0 1-1.8-.9l.5-.4c3.5 1.6 7.3 1.6 10.7 0l.6.4a11 11 0 0 1-1.8.9l1.1 1.5a15 15 0 0 0 4.7-2.3c.4-4-.6-7.5-2.1-10.5ZM8.7 14a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Zm6.6 0a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Z" class="fill"/></svg>',
};
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="description" content="AlitaaTV: gaming, comunidad y buena onda. Directos en Twitch y Los Alitos, nuestro server de mundo abierto en MTA." /><meta name="theme-color" content="#0d0a12" /><link rel="canonical" href={`https://${site.domain}/`} /><link rel="icon" type="image/png" href="/images/logo-round.png" /><meta property="og:type" content="website" /><meta property="og:title" content="AlitaaTV · Gaming, comunidad y buena onda" /><meta property="og:description" content="Directos en Twitch y Los Alitos, nuestro server de mundo abierto en MTA." /><meta property="og:image" content={`https://${site.domain}/images/banner.jpg`} /><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><title>AlitaaTV · Gaming, comunidad y buena onda</title></head>
<body><a class="skip" href="#contenido">Saltar al contenido</a>
<main id="contenido">
<section class="hero" id="inicio">
  <div class="hero-copy">
    <nav class="nav" aria-label="Navegación principal"><a class="brand" href="#inicio"><Fragment set:html={crown} /><span>AlitaaTV</span></a><div class="nav-links"><a href="#server-mta">Server MTA</a><a href="#objetivo">Donar</a></div></nav>
    <div><h1>Gaming, comunidad y <i>buena onda</i></h1><a class="button violet" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ▶</a><div class="social-icons social-row">{socials.map(link => <a href={link.url} target="_blank" rel="noreferrer" aria-label={link.name} title={link.name} set:html={icons[link.icon as keyof typeof icons]} />)}</div></div>
    <div class="countdown" data-countdown>
      <p class="label">PRÓXIMO DIRECTO</p>
      <div class="countdown-grid" role="timer" aria-label="Tiempo que falta para el próximo directo"><div><b data-unit="days">--</b><span>días</span></div><div><b data-unit="hours">--</b><span>horas</span></div><div><b data-unit="minutes">--</b><span>min</span></div><div><b data-unit="seconds">--</b><span>seg</span></div></div>
      <p class="countdown-local" data-local-time>Lunes a viernes · 22:00 hora de España</p>
    </div>
  </div>
  <div class="hero-visual"><img src="/images/profile.png" alt="Ilustración de AlitaaTV sonriendo en su setup gamer" width="1024" height="1024" fetchpriority="high" /><div class="social-icons social-rail">{socials.map(link => <a href={link.url} target="_blank" rel="noreferrer" aria-label={link.name} title={link.name} set:html={icons[link.icon as keyof typeof icons]} />)}</div></div>
</section>
<div class="tape"><div class="tape-track">{[0, 1].map(group => <p class="tape-group" aria-hidden={group > 0 ? 'true' : undefined}>{Array.from({ length: 4 }, () => site.tape).flat().map(item => <><span>{item}</span><i aria-hidden="true">✦</i></>)}</p>)}</div></div>
<section class="server" id="server-mta">
  <a class="server-shot" href={site.mta.url} target="_blank" rel="noreferrer" aria-label="Ir a la web del server Los Alitos"><img src={site.mta.image} alt="Un jugador en una terraza de Las Venturas de noche, con las luces de los casinos de fondo" width="1280" height="720" loading="lazy" /></a>
  <div class="shell server-copy"><p class="label">LOS ALITOS · MTA:SA</p><h2>Server Mundo Abierto 2026</h2><p class="server-text">El server freeroam de la comunidad, con trabajos, casas, casino y eventos como carreras, shooter, deathmatch y más.</p><div class="actions"><a class="button cream" href={site.mta.url} target="_blank" rel="noreferrer">Conocé el server ↗</a><a class="button outline" href={site.mta.discord} target="_blank" rel="noreferrer">Discord MTA ↗</a></div></div>
</section>
<section class="goal" id="objetivo"><div class="shell"><div class="goal-card"><Fragment set:html={crown} /><p class="label">OBJETIVO</p><h2>Una PC para subir de nivel</h2><p class="goal-text">Mejores directos y mejores jueguitos con ustedes. Cualquier aporte ayuda un montón.</p><a class="button cream" href={site.support.tip} target="_blank" rel="noreferrer">Hacer una donación ↗</a><p class="goal-note">Hoy: {site.setup}</p></div></div></section>
</main>
<footer><div class="shell foot"><a class="brand" href="#inicio"><Fragment set:html={crown} /><span>AlitaaTV</span></a><p>Merch · Próximamente</p><a href={`mailto:${site.email}`}>Contacto: {site.email}</a><p>© {new Date().getFullYear()} AlitaaTV</p></div></footer>
<script>
  // Los directos son de lunes a viernes a las 22:00 de España; cada visitante ve su hora local.
  const madrid = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const madridParts = (date: Date) => Object.fromEntries(madrid.formatToParts(date).filter(part => part.type !== 'literal').map(part => [part.type, Number(part.value)]));
  const nextStream = (now: Date) => {
    const today = madridParts(now);
    for (let offset = 0; ; offset++) {
      const weekday = new Date(Date.UTC(today.year, today.month - 1, today.day + offset)).getUTCDay();
      if (weekday === 0 || weekday === 6) continue;
      const guess = new Date(Date.UTC(today.year, today.month - 1, today.day + offset, 22));
      const shown = madridParts(guess);
      const stream = new Date(2 * guess.getTime() - Date.UTC(shown.year, shown.month - 1, shown.day, shown.hour, shown.minute));
      if (stream > now) return stream;
    }
  };
  const setUnit = (unit: string, value: number) => { const element = document.querySelector(`[data-unit="${unit}"]`); if (element) element.textContent = String(value).padStart(2, '0'); };
  const localTime = new Intl.DateTimeFormat('es', { weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const localLabel = document.querySelector('[data-local-time]');
  const tick = () => {
    const now = new Date();
    const stream = nextStream(now);
    const seconds = Math.floor((stream.getTime() - now.getTime()) / 1000);
    setUnit('days', Math.floor(seconds / 86400));
    setUnit('hours', Math.floor(seconds % 86400 / 3600));
    setUnit('minutes', Math.floor(seconds % 3600 / 60));
    setUnit('seconds', seconds % 60);
    if (localLabel) localLabel.textContent = `${localTime.format(stream)} · tu hora local`;
  };
  tick();
  setInterval(tick, 1000);
</script>
</body></html>

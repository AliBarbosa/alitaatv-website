---
import '../styles/global.css';
import { site } from '../data/site';
const schema = {'@context':'https://schema.org','@type':'Person',name:site.name,url:`https://${site.domain}`,sameAs:[site.twitch,...site.links.map(link => link.url),...site.socials.map(social => social.url)]};
const icons = {
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" class="fill"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.1a3.8 3.8 0 1 1-3.2-3.75V7.2A7 7 0 1 0 17 14V8.5c1 .8 2.3 1.3 4 1.3V6.6c-2.1 0-3.7-1.4-4-3.6z" class="fill"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2C2.5 10 2.5 12 2.5 12s0 2 .5 3.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2c.5-1.8.5-3.8.5-3.8s0-2-.5-3.8z" class="fill"/><path d="m10 15 5-3-5-3z" class="cut"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.8 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.5 1.6-1.5H17V3.7c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.2H8v3.1h2.6v8z" class="fill"/></svg>',
  discord: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 5.2A16 16 0 0 0 15.7 4l-.5 1a14 14 0 0 0-6.4 0l-.5-1a16 16 0 0 0-3.8 1.2C2.1 8.8 1.5 12.3 1.8 15.7A15.3 15.3 0 0 0 6.5 18l1.1-1.5a9 9 0 0 1-1.8-.9l.5-.4c3.5 1.6 7.3 1.6 10.7 0l.6.4a11 11 0 0 1-1.8.9l1.1 1.5a15 15 0 0 0 4.7-2.3c.4-4-.6-7.5-2.1-10.5ZM8.7 14a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Zm6.6 0a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Z" class="fill"/></svg>',
  patreon: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="14.5" cy="9" r="5.5" class="fill"/><path d="M4 3.5h3.2v17H4z" class="fill"/></svg>'
};
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="description" content="AlitaaTV: gaming, risas y una comunidad que decide cada partida." /><meta name="theme-color" content="#10051f" /><link rel="canonical" href={`https://${site.domain}/`} /><link rel="icon" type="image/png" href="/images/logo-round.png" /><meta property="og:type" content="website" /><meta property="og:title" content="AlitaaTV · Gaming, risas y comunidad" /><meta property="og:description" content="Directos, clips y los mejores momentos de la comunidad." /><meta property="og:image" content={`https://${site.domain}/images/banner.jpg`} /><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><title>AlitaaTV · Gaming, risas y comunidad</title></head>
<body><a class="skip" href="#contenido">Saltar al contenido</a><header><nav class="shell nav" aria-label="Navegación principal"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="46" height="46" /><span>AlitaaTV</span></a><div class="nav-links"><a href="#destacados">Destacado</a><a href="#objetivo">Mi setup</a><a href="#merch">Próximamente</a><a class="live" href={site.twitch} target="_blank" rel="noreferrer">Ver directo ↗</a></div></nav></header>
<main id="contenido"><section class="hero" id="inicio"><div class="grid"></div><div class="shell hero-in"><div class="copy"><p class="eyebrow">TE INVITO A FORMAR PARTE</p><h1>Gaming, comunidad<br /><i>y buena onda.</i></h1><p>Directos en Twitch donde el objetivo es jugar, reírnos y pasar un buen rato conversando como lo harías con cualquier amigo.</p><div class="actions"><a class="button primary" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ▶</a></div><p class="schedule">Lun — Vie · <strong data-local-time>22:00</strong> · <span>tu hora local</span></p><div class="social-icons" aria-label="Enlaces de AlitaaTV">{site.links.map(link => <a class={`social-icon ${link.icon}`} href={link.url} target="_blank" rel="noreferrer" aria-label={link.name} title={link.name} set:html={icons[link.icon as keyof typeof icons]} />)}</div><a class="contact-button mobile-contact" href={`mailto:${site.email}`}><span aria-hidden="true">✉</span><span>Contactate conmigo</span></a></div><div class="visual"><div class="ring"></div><img class="profile" src="/images/profile.png" alt="Ilustración de AlitaaTV sonriendo en su setup gamer" width="1024" height="1024" fetchpriority="high" /><button class="contact-button" type="button" data-contact-email={site.email}><span aria-hidden="true">✉</span><span data-contact-label>Contactate conmigo</span></button></div></div></section>
<section class="semalita featured" id="destacados"><div class="shell"><div class="heading"><div><p class="label">CONTENIDO DESTACADO</p><h2>Para que no te <i>pierdas de nada.</i></h2></div></div><div class="featured-grid">{site.featured.map(video => <article class={`featured-video ${video.platform === 'YouTube' ? 'youtube-video' : ''}`}><iframe src={video.embed} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe><a href={video.url} target="_blank" rel="noreferrer">Ver en {video.platform} ↗</a></article>)}</div><div class="featured-cta"><a class="button primary" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ▶</a></div></div></section>
<section class="upgrade" id="objetivo"><div class="shell upgrade-in"><aside class="setup-card laptop"><div class="laptop-screen"><i class="laptop-camera" aria-hidden="true"></i><p class="setup-label">MI SETUP ACTUAL</p><h3>HP Omen 15</h3><ul><li><span>CPU</span><strong>Ryzen 7 4800H</strong></li><li><span>GPU</span><strong>RTX 2060 · 6 GB</strong></li><li><span>RAM</span><strong>16 GB</strong></li></ul><p class="setup-note">La compa que nos trajo hasta acá 🤍</p></div><div class="laptop-base" aria-hidden="true"></div></aside><div class="upgrade-copy"><p class="label">EL OBJETIVO</p><h2>Una PC para seguir<br /><i>subiendo de nivel.</i></h2><p>Quiero mejorar la calidad de los directos y poder jugar mejores jueguitos con ustedes. Si te interesa ser parte de ese salto, cualquier aporte ayuda un montón.</p><p class="support-kicker">¿Te interesa apoyar este objetivo?</p><div class="support-actions"><a class="button primary" href={site.support.patreon} target="_blank" rel="noreferrer">Apoyar por mes · Patreon ↗</a><a class="button ghost" href={site.support.tip} target="_blank" rel="noreferrer">Aportar una vez · Tip ↗</a></div></div></div></section>
<section class="shell merch" id="merch"><div><small>PRÓXIMAMENTE</small><h2>Merch para la comunidad<i>🤩</i></h2></div><p>Esto se está cocinando...<br />¡estate alerta a las actualizaciones!</p><img src="/images/logo-mark.png" alt="" width="180" height="180" loading="lazy" /></section></main>
<footer><div class="shell foot"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="40" height="40" /><span>AlitaaTV</span></a><div class="footer-links">{site.socials.map(social => <a href={social.url} target="_blank" rel="noreferrer">{social.name}</a>)}<a href={`mailto:${site.email}`}>Contacto</a></div><p>© {new Date().getFullYear()} AlitaaTV</p></div></footer><script>const p=d=>Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));const now=new Date(),m=p(now),g=new Date(Date.UTC(+m.year,+m.month-1,+m.day,22)),q=p(g),stream=new Date(g.getTime()-(Date.UTC(+q.year,+q.month-1,+q.day,+q.hour,+q.minute)-g.getTime())),local=new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(stream);document.querySelectorAll('[data-local-time]').forEach(e=>e.textContent=local);const contact=document.querySelector('[data-contact-email]');contact?.addEventListener('click',async()=>{const email=contact.dataset.contactEmail,label=contact.querySelector('[data-contact-label]');try{await navigator.clipboard.writeText(email);if(label){label.textContent='Email copiado ✓';setTimeout(()=>label.textContent='Contactate conmigo',2200)}}catch{window.location.href=`mailto:${email}`}});</script></body></html>

---
import '../styles/global.css';
import { site } from '../data/site';
const schema = {'@context':'https://schema.org','@type':'Person',name:site.name,url:`https://${site.domain}`,sameAs:[site.twitch,...site.links.map(link => link.url),...site.socials.map(social => social.url)]};
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="description" content="AlitaaTV: gaming, risas y una comunidad que decide cada partida." /><meta name="theme-color" content="#10051f" /><link rel="canonical" href={`https://${site.domain}/`} /><link rel="icon" type="image/png" href="/images/logo-round.png" /><meta property="og:type" content="website" /><meta property="og:title" content="AlitaaTV · Gaming, risas y comunidad" /><meta property="og:description" content="Directos, clips y los mejores momentos de la comunidad." /><meta property="og:image" content={`https://${site.domain}/images/banner.jpg`} /><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><title>AlitaaTV · Gaming, risas y comunidad</title></head>
<body><a class="skip" href="#contenido">Saltar al contenido</a><header><nav class="shell nav" aria-label="Navegación principal"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="46" height="46" /><span>AlitaaTV</span></a><div class="nav-links"><a href="#semalita">La Semalita</a><a href="#merch">Merch</a><a class="live" href={site.twitch} target="_blank" rel="noreferrer">Ver directo ↗</a></div></nav></header>
<main id="contenido"><section class="hero" id="inicio"><div class="grid"></div><div class="shell hero-in"><div class="copy"><p class="eyebrow">● LA PARTIDA EMPIEZA AQUÍ</p><h1>Gaming, risas<br /><i>y buena vibra.</i></h1><p>Directos sin guion, clips para repetir y una comunidad que siempre tiene algo que decir.</p><div class="actions"><a class="button primary" href={site.twitch} target="_blank" rel="noreferrer">Ver en directo ▶</a><a class="button ghost" href="#links">Todos los links ↓</a></div><p class="schedule">Lun — Vie · <strong data-local-time>22:00</strong> · <span>tu hora local</span></p></div><div class="visual"><div class="ring"></div><img class="profile" src="/images/profile.png" alt="Ilustración de AlitaaTV sonriendo en su setup gamer" width="1024" height="1024" fetchpriority="high" /><span class="badge">● EN VIVO<br /><small>en Twitch</small></span></div></div></section>
<section class="quick shell" id="links"><div class="section-title"><p class="label">ENCUÉNTRAME AQUÍ</p><h2>Todo lo importante.<br /><i>En un clic.</i></h2></div><div class="link-grid">{site.links.map(link => <a class={`link-card ${link.tone}`} href={link.url} target="_blank" rel="noreferrer"><b>{link.icon}</b><span><strong>{link.name}</strong><small>{link.detail}</small></span><em>↗</em></a>)}</div></section>
<section class="semalita" id="semalita"><div class="shell"><div class="heading"><div><p class="label">LA SEMALITA</p><h2>El resumen del<br /><i>caos semanal.</i></h2></div><p>Los mejores momentos del stream, reunidos una vez por semana.</p></div><div class="reels">{site.semalita.map((reel,index) => <a class={`reel reel-${index + 1}`} href={reel.url} target="_blank" rel="noreferrer"><span>REEL · INSTAGRAM</span><b>▶</b><strong>{reel.title}</strong><small>Ver en Instagram ↗</small></a>)}</div><a class="textlink" href="https://www.instagram.com/alitaatv" target="_blank" rel="noreferrer">Ver todas las Semalitas en Instagram ↗</a></div></section>
<section class="shell merch" id="merch"><div><small>PRÓXIMAMENTE</small><h2>Merch de otro<br /><i>universo.</i></h2></div><p>Estamos preparando algo especial para que lleves la vibra de AlitaaTV contigo.</p><img src="/images/logo-mark.png" alt="" width="180" height="180" loading="lazy" /></section></main>
<footer><div class="shell foot"><a class="brand" href="#inicio"><img src="/images/logo-mark.png" alt="" width="40" height="40" /><span>AlitaaTV</span></a><div class="footer-links">{site.socials.map(social => <a href={social.url} target="_blank" rel="noreferrer">{social.name}</a>)}<a href={`mailto:${site.email}`}>Contacto</a></div><p>© {new Date().getFullYear()} AlitaaTV</p></div></footer><script>const p=d=>Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));const now=new Date(),m=p(now),g=new Date(Date.UTC(+m.year,+m.month-1,+m.day,22)),q=p(g),stream=new Date(g.getTime()-(Date.UTC(+q.year,+q.month-1,+q.day,+q.hour,+q.minute)-g.getTime())),local=new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(stream);document.querySelectorAll('[data-local-time]').forEach(e=>e.textContent=local);</script></body></html>
